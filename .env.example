# Environment Variables Template for Production & Vercel

# 1. PostgreSQL Database URL (Required on Vercel / Serverless)
# You can get this from Vercel Postgres, Neon (neon.tech), Supabase, or Railway.
# Example: postgresql://username:password@ep-cool-forest-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"

# 2. Cryptographic Secret for AES-256-GCM Token Encryption (Required - Exactly 32 characters)
# Generate any 32-char string. Example:
ENCRYPTION_SECRET="production_super_secret_key_32c"

# 3. Public Application Domain (Used to generate postback URLs)
# Example: https://track.yourdomain.com or https://wecantrack.vercel.app
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
